{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shell Test Report",
  "type": "object",
  "required": ["ok", "chain", "runner", "startedAt", "finishedAt", "command", "exitCode", "summary"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "Whether the test/run passed"
    },
    "chain": {
      "type": "string",
      "enum": ["evm", "solana"],
      "description": "Blockchain chain"
    },
    "runner": {
      "type": "string",
      "enum": ["forge", "hardhat", "anchor", "slither"],
      "description": "Test runner or tool used"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the run started"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the run finished"
    },
    "cwd": {
      "type": "string",
      "description": "Working directory where the command was run"
    },
    "command": {
      "type": "string",
      "description": "Full command that was executed"
    },
    "exitCode": {
      "type": "integer",
      "description": "Process exit code"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary"
    },
    "rawLogPath": {
      "type": "string",
      "description": "Path to raw log file"
    },
    "details": {
      "type": "object",
      "description": "Runner-specific details",
      "properties": {
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
