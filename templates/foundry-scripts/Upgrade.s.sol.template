pragma solidity ^0.8.24;

import {Script, console2} from "forge-std/Script.sol";
import {ERC1967Proxy} from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";
import {${IMPLEMENTATION_NAME}} from "../src/${IMPLEMENTATION_NAME}.sol";

contract UpgradeScript is Script {
    function run() external returns (address implementation) {
        address proxy = vm.envAddress("PROXY_ADDRESS");

        vm.startBroadcast();
        ${IMPLEMENTATION_NAME} newImplementation = new ${IMPLEMENTATION_NAME}(${CONSTRUCTOR_ARGS});
        implementation = address(newImplementation);
        ERC1967Proxy(payable(proxy)).upgradeTo(implementation);
        vm.stopBroadcast();

        console2.log("Proxy upgraded", proxy);
        console2.log("New implementation", implementation);
    }
}
