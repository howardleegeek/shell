{
  "solana-mcp": {
    "name": "solana-mcp",
    "description": "Solana MCP server (sendaifun/solana-mcp)",
    "repo": "sendaifun/solana-mcp",
    "install": "npx solana-mcp",
    "type": "solana",
    "enabled": true,
    "capabilities": ["wallet_ops", "spl_tokens", "nft_mint", "TPS_metrics"]
  },
  "evm-mcp-server": {
    "name": "evm-mcp-server",
    "description": "EVM MCP server (mcpdotdirect/evm-mcp-server)",
    "repo": "mcpdotdirect/evm-mcp-server",
    "install": "npx evm-mcp-server",
    "type": "evm",
    "enabled": true,
    "capabilities": ["balances", "contract_reads_writes", "ERC-20/721/1155", "ENS"]
  }
}
